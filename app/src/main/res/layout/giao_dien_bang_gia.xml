<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nen_xam">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_the_trang"
            android:orientation="vertical"
            android:padding="14dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/price_car"
                android:textColor="@color/xanh_duong"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/price_car_first"
                android:textColor="@color/chu_phu"
                android:textSize="12sp"/>
            <EditText
                android:id="@+id/et_oto_2h"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_the_trang"
                android:inputType="number"
                android:padding="10dp"
                android:textColor="#202124"
                android:textColorHint="#78829A"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/price_hour_next"
                android:textColor="@color/chu_phu"
                android:textSize="12sp"/>
            <EditText
                android:id="@+id/et_oto_gio_tiep"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_the_trang"
                android:inputType="number"
                android:padding="10dp"
                android:textColor="#202124"
                android:textColorHint="#78829A"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_the_trang"
            android:orientation="vertical"
            android:padding="14dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/price_motor"
                android:textColor="@color/mau_do"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/price_turn"
                android:textColor="@color/chu_phu"
                android:textSize="12sp"/>
            <EditText
                android:id="@+id/et_xe_may_luot"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_the_trang"
                android:inputType="number"
                android:padding="10dp"
                android:textColor="#202124"
                android:textColorHint="#78829A"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/price_night"
                android:textColor="@color/chu_phu"
                android:textSize="12sp"/>
            <EditText
                android:id="@+id/et_xe_may_dem"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_the_trang"
                android:inputType="number"
                android:padding="10dp"
                android:textColor="#202124"
                android:textColorHint="#78829A"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_the_trang"
            android:orientation="vertical"
            android:padding="14dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/price_bike"
                android:textColor="@color/cam"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/price_turn"
                android:textColor="@color/chu_phu"
                android:textSize="12sp"/>
            <EditText
                android:id="@+id/et_xe_dap_luot"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_the_trang"
                android:inputType="number"
                android:padding="10dp"
                android:textColor="#202124"
                android:textColorHint="#78829A"/>
        </LinearLayout>
        <Button
            android:id="@+id/btn_luu_bang_gia"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/xanh_chinh"
            android:text="@string/price_save"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>
</ScrollView>
