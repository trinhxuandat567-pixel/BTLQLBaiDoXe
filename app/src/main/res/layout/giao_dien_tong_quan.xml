<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nen_xam">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_the_trang"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <Spinner
                android:id="@+id/sp_moc_thoi_gian"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:spinnerMode="dropdown"/>
        </LinearLayout>
        <TextView
            android:id="@+id/tv_mo_ta_thong_ke"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="@string/stats_today_default"
            android:textColor="@color/chu_chinh"
            android:textSize="13sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/tv_ket_qua_thong_ke"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_the_trang"
            android:padding="12dp"
            android:text="@string/stats_default"
            android:textColor="@color/chu_phu"
            android:textSize="13sp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_the_trang"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="@string/revenue"
                    android:textColor="@color/chu_phu"
                    android:textSize="11sp"/>
                <TextView
                    android:id="@+id/tv_doanh_thu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/all_zero"
                    android:textColor="@color/cam"
                    android:textSize="24sp"
                    android:textStyle="bold"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/money_icon"
                android:textSize="26sp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_the_trang"
            android:orientation="horizontal"
            android:padding="16dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/entries"
                    android:textColor="@color/chu_phu"
                    android:textSize="11sp"/>
                <TextView
                    android:id="@+id/tv_luot_vao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/zero_count"
                    android:textColor="@color/xanh_duong"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/exits"
                    android:textColor="@color/chu_phu"
                    android:textSize="11sp"/>
                <TextView
                    android:id="@+id/tv_luot_ra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/zero_count"
                    android:textColor="@color/xanh_la_chu"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_the_trang"
            android:orientation="vertical"
            android:padding="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fill_rate"
                    android:textColor="@color/chu_chinh"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tv_ty_le_tai"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/zero_rate"
                    android:textColor="@color/xanh_duong"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>
            <ProgressBar
                android:id="@+id/progress_tong_quat"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/xanh_duong"/>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/zone_status"
            android:textColor="@color/chu_chinh"
            android:textSize="16sp"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/zone_hint"
            android:textColor="@color/chu_phu"
            android:textSize="12sp"/>
        <include
            android:id="@+id/khu_a"
            layout="@layout/dong_khu_thong_ke"/>
        <include
            android:id="@+id/khu_b"
            layout="@layout/dong_khu_thong_ke"/>
        <include
            android:id="@+id/khu_c"
            layout="@layout/dong_khu_thong_ke"/>
    </LinearLayout>
</ScrollView>
